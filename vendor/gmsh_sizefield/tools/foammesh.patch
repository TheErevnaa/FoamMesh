+// FOAMMESH: collect every leaf (center, edge length, prescribed size, level,
+// corner points) so the driver can write the octree as a .vtu and estimate
+// per region. Corner points are shared between leaves: they are keyed by
+// their integer octree coordinates, which are exact, so the written grid is
+// a connected hexahedral mesh, not eight points per leaf.
+#include <unordered_map>
+struct forest_collect_ctx {
+  std::vector<forest_leaf_t> *leaves;
+  std::vector<double> *points;
+  std::unordered_map<uint64_t, uint32_t> index; // packed (x,y,z) -> point
+};
 
